# 统一编辑器风格（VS Code / JetBrains / Vim 等均支持）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,pdf}]
insert_final_newline = false
